NODE_ENV=production
PORT=5000
FRONTEND_URL=https://keyroutes.co
BACKEND_PUBLIC_URL=https://api.keyroutes.co
MONGO_URI=mongodb://127.0.0.1:27017/keyroutes
DNS_SERVERS=
JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=8h
SETTINGS_ENCRYPTION_KEY=replace-with-another-long-random-secret
COMPANY_NAME=KeyRoutes
WEBSITE_URL=https://keyroutes.co
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_NAME=KeyRoutes
FROM_EMAIL=
ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PHONE=

# Enable only after configuring matching frontend and server keys.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=keyroutes.co,www.keyroutes.co,localhost,127.0.0.1
