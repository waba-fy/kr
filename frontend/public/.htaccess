<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^robots\.txt$ crawl.php?document=robots [L]
RewriteRule ^sitemap\.xml$ crawl.php?document=sitemap [L]
RewriteRule ^llms\.txt$ crawl.php?document=llms [L]
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>
